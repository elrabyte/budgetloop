server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Proxy API calls to the BudgetLoop api container. The client's fetch wrapper
    # (src/api/client.ts) always calls relative `/api/...` URLs, so this is the only place that
    # needs to know the api service's address.
    #
    # Upstream host/port are configurable via the API_HOST / API_PORT environment variables
    # (defaults: api / 4000, see Dockerfile) - this file is a *template*, processed by the base
    # nginx image's built-in envsubst-on-templates entrypoint script into
    # /etc/nginx/conf.d/default.conf before nginx starts. This makes the same image work both:
    #  - as part of a Docker Compose stack (default: API_HOST=api resolves via Compose's
    #    per-project DNS, since api/client share a network), and
    #  - as fully standalone containers/apps with no shared network (e.g. two independent
    #    TrueNAS "Custom Apps") - in that case override API_HOST/API_PORT to wherever the api
    #    container is actually reachable, e.g. the host's IP and the api container's published
    #    port.
    #
    # proxy_pass targets a variable (not a literal host) and `resolver` points at Docker's
    # embedded DNS server, so nginx resolves the upstream at *request* time instead of failing to
    # start (previously: "host not found in upstream") if the hostname isn't resolvable the
    # instant nginx boots (container start order isn't guaranteed).
    resolver 127.0.0.11 valid=30s;
    set $upstream_api "${API_HOST}:${API_PORT}";

    location /api/ {
        proxy_pass http://$upstream_api/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA fallback: let React Router handle client-side routes.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
